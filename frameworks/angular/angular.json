{
  "version": 1,
  "projects": {
    "relay": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "styles": ["../../shared/tokens.css", "../../shared/styles.css"],
            "assets": [{ "glob": "**/*", "input": "public", "output": "/" }],
            "outputMode": "static"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "relay:build" }
        }
      }
    }
  }
}
