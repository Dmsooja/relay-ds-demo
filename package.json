{
  "name": "@sc-demo/relay-ds-demo",
  "description": "Relay DS React components and shared design tokens, with Red and Blue themes.",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:wc": "vite --mode web-components --host 127.0.0.1",
    "dev:hybrid": "vite --mode react-web-components --host 127.0.0.1",
    "dev:angular": "npm --prefix frameworks/angular start",
    "dev:native": "npm --prefix frameworks/react-native start",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:library && vite build && vite build --mode web-components && vite build --mode react-web-components",
    "build:library": "vite build --mode library && tsc -p tsconfig.build.json",
    "prepack": "npm run build:library",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "code-connect:validate": "node scripts/check-connect.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "files": [
    "dist/",
    "src/styles/tokens.css",
    "shared/tokens.mjs",
    "shared/tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/shared/tokens.d.mts",
      "import": "./shared/tokens.mjs"
    },
    "./styles": "./dist/style.css",
    "./style.css": "./dist/style.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "devDependencies": {
    "@figma/code-connect": "2.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright-core": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
